    const sendBtn = document.getElementById('send-btn');
    const micBtn = document.getElementById('mic-btn');
    const chips = document.querySelectorAll('.suggestion-chip');
    const contextPills = document.querySelectorAll('.context-pill');

    contextPills.forEach(pill => {
      pill.addEventListener('click', () => {
        contextPills.forEach(p => {
          p.classList.remove('bg-slate-900', 'text-white', 'border-slate-900');
          p.classList.add('bg-white', 'text-slate-600', 'border-slate-200');
        });
        pill.classList.remove('bg-white', 'text-slate-600', 'border-slate-200');
        pill.classList.add('bg-slate-900', 'text-white', 'border-slate-900');
      });
    });

    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        const text = chip.getAttribute('data-prompt');
        if (input && text) {
          input.value = text;
          input.focus();
        }
      });
    });

    let isRecording = false;
    if (micBtn) {
      micBtn.addEventListener('click', () => {
        isRecording = !isRecording;
        if (isRecording) {
          micBtn.classList.add('bg-rose-50', 'text-rose-600');
        } else {
          micBtn.classList.remove('bg-rose-50', 'text-rose-600');
        }
      });
    }

    if (sendBtn && input) {
      sendBtn.addEventListener('click', () => {
        if (input.value.trim() !== '') {
          input.value = '';
          input.placeholder = 'Processing query against verified ledger...';
          setTimeout(() => {
            input.placeholder = 'Ask Biz Assist about financials, team, or operations...';
